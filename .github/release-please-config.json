{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "44387f92edcdaa90a1292f0ad18eb6d512838a9a",
  "versioning": "default",
  "release-type": "go",
  "changelog-path": "CHANGELOG.md",
  "changelog-sections": [
    { "type": "feat", "section": "🚀 New Features" },
    { "type": "fix", "section": "🪲 Bug Fixes" },
    { "type": "perf", "section": "🏎️ Performance Improvements" },
    { "type": "revert", "section": "↩️ Reverts" },
    { "type": "deps", "section": "📦 Dependencies" },
    { "type": "docs", "section": "📝 Documentation" },
    { "type": "chore", "section": "🧹 Miscellaneous Chores" },
    { "type": "refactor", "section": "⌨️ Code Refactoring" },
    { "type": "test", "section": "📚 Tests" },
    { "type": "build", "section": "🔨 Build System" },
    { "type": "ci", "section": "✅ Continuous Integration" }
  ],
  "pull-request-title-pattern": "chore: Release ${version}",
  "pull-request-header": "Automatically generated with [Release Please](https://github.com/googleapis/release-please).",
  "pull-request-footer": "",
  "include-v-in-tag": true,
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "draft": false,
  "prerelease": false,
  "always-update": true,
  "packages": {
    ".": {
      "include-component-in-tag": false,
      "version-file": "types.go",
      "exclude-paths": ["agentframework", "examples/agentframework"],
      "extra-files": [
        {
          "type": "generic",
          "path": "sensitiveinfo/rampart/go.mod",
          "glob": false
        },
        {
          "type": "generic",
          "path": "examples/nethttp/go.mod",
          "glob": false
        },
        {
          "type": "generic",
          "path": "examples/agentframework/go.mod",
          "glob": false
        }
      ]
    }
  }
}
